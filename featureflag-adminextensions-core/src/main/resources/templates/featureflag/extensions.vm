## Velocity template for Extensions menu item
#if($services.featureflag && $services.featureflag.extensions && $services.featureflag.extensions.isEnabled())
  #set($extensionsEnabled = true)
#else
  #set($extensionsEnabled = false)
#end

#if($extensionsEnabled)
  <li class="admin-menu-item admin-extensions-item">
    <a href="$xwiki.getURL('XWiki.XWikiExtensions', 'view')"
       title="$services.localization.render('admin.extensions.description')">
      <span class="menu-icon">📦</span>
      <span class="menu-label">$services.localization.render('admin.extensions.title')</span>
    </a>
  </li>
#else
  <!-- Extensions admin is disabled by feature flag -->
#end

## JavaScript for dynamic hiding
<script>
require(['jquery'], function($) {
  $(document).ready(function() {
    #if(!$extensionsEnabled)
      // Hide Extensions menu items
      $('a[href*="XWikiExtensions"]').closest('li').hide();
      $('[data-admin-section="extensions"]').hide();

      // Add CSS class for styling
      $('body').addClass('extensions-disabled');
    #end
  });
});
</script>

<style>
.extensions-disabled .admin-extensions-item {
  display: none !important;
}
</style>